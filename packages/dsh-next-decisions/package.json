{
  "name": "@dsh-next/dsh-next-decisions",
  "icon": "./assets/icon.svg",
  "description": "DeepSeek Harness plugin: configure decision-only providers with explicit model IDs.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": { "dsh": ">=0.1.7-rc.1" },
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["@deepseek-ai/dsh-api-remotes"], "platform": "web" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": { "react": "^18.2.0" },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-models": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.1",
    "@deepseek-ai/dsh-credentials": "0.1.7-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^22.20.4",
    "@types/react": "~18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "~5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "files": ["locale", "assets", "lib", "cordis.patch.yml", "README.md", "README.zh.md", "media"],
  "license": "MIT",
  "author": "Rok Grabnar <sitegroove>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-next/dsh-next-plugins.git",
    "directory": "packages/dsh-next-decisions"
  }
}
