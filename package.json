{
  "name": "dsh-next-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness plugin family published under the @dsh-next npm scope: notifications, integrations, automation, and workflow plugins.",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm run test:unit && pnpm run test:scripts",
    "test:unit": "pnpm -r test",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run runtime-deps:check && pnpm run docs:check && pnpm run i18n:check",
    "ci": "pnpm run check && pnpm run test:e2e",
    "test:e2e": "node scripts/workflow.mjs e2e",
    "test:live": "node scripts/workflow.mjs live",
    "doctor": "node scripts/workflow.mjs doctor",
    "plugin:pack": "node scripts/workflow-pack.mjs pack",
    "plugin:install": "node scripts/workflow-pack.mjs install",
    "npm:auth-test": "node scripts/npm-auth-test.mjs",
    "preview:skills": "node scripts/workflow-preview.mjs skills",
    "capture:worktrees": "node scripts/workflow-preview.mjs worktrees",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "change": "changeset",
    "release": "changeset publish --tag latest",
    "release:canary": "changeset version --snapshot canary && changeset publish --tag canary --no-git-tag",
    "docs:check": "node scripts/verify-docs.mjs",
    "docs:list": "node scripts/verify-docs.mjs --list",
    "docs:write-pair": "node scripts/verify-docs.mjs --write",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:list": "node scripts/i18n-check.mjs --list",
    "plugin:new": "node scripts/dsh-plugin-new.mjs",
    "runtime-deps:check": "node scripts/runtime-deps-check.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "dev": "node scripts/workflow.mjs dev"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@playwright/test": "^1.62.1",
    "lightningcss": "^1.32.0",
    "playwright": "^1.62.1",
    "semver": "^7.8.5",
    "tsdown": "^0.22.2"
  },
  "license": "MIT",
  "author": "Rok Grabnar <sitegroove>"
}
