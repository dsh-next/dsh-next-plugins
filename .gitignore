# Dependencies and build artifacts
node_modules/

# Auth tokens live in the user-level ~/.npmrc; the committed .npmrc contains
# only the @dsh-next scope -> registry mapping (no secrets, tracked).

# Local tool caches
*.log
.DS_Store
.codegraph/
.zcode/

# GUI test screenshots
gui-test-screenshots/

# Plugin worktree checkouts, sidecar registry, and local debug probes
.dsh/

# pnpm in-project package store (local dependency cache; never committed)
.pnpm-store/

# Mount smoke artifacts (scripts/e2e-mount.sh)
*.tgz
playwright-report/
test-results/
docs/screenshots/

# Local artifacts and GUI design session drafts
/artifacts/
/tmp/
/design/session-*/

# Build output (tsdown)
packages/*/lib/
.dsh-next-skills-smoke/

# Runtime skill installs (workspace-scoped cc-plugins installs land in
# .agents/skills/ next to this repo's own dsh-next-* skills)
/.agents/skills/*
!/.agents/skills/dsh-next-*/

# Local credential/config files (never publish or commit)
.env
.env.*
!.env.example
mise.local.toml
.mise.local.toml
